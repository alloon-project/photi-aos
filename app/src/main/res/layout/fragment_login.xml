<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="fragment"
            type="com.photi.aos.view.fragment.auth.LoginFragment" />
        <variable
            name="viewModel"
            type="com.photi.aos.viewmodel.AuthViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/Theme.Photi">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/id_constraintlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/id_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:background="@drawable/input_line_default"
                android:ems="10"
                android:fontFamily="@font/suit_medium"
                android:hint="아이디를 입력해주세요"
                android:inputType="text"
                android:text="@={viewModel.id}"
                android:textColor="@color/black"
                android:textColorHint="@color/gray400"
                android:textSize="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/id_linearlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/id_edittext"
                app:layout_constraintTop_toBottomOf="@+id/id_edittext">

                <ImageView
                    android:id="@+id/id_error_imgview"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close_default" />

                <TextView
                    android:id="@+id/id_error_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/suit_medium"
                    android:text="@string/loginerror"
                    android:textColor="@color/red400"
                    android:textSize="12dp"
                    android:layout_marginLeft="6dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pw_constraintlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id_constraintlayout"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:id="@+id/pw_framelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <EditText
                    android:id="@+id/pw_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_line_default"
                    android:ems="10"
                    android:fontFamily="@font/suit_medium"
                    android:hint="비밀번호를 입력해주세요"
                    android:inputType="textPassword"
                    android:text="@={viewModel.password}"
                    android:textColorHint="@color/gray400"
                    android:textSize="14dp" />

                <ImageButton
                    android:id="@+id/hide_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="16dp"
                    android:background="@drawable/ic_eye_off"
                    android:tag="0" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/pw_linearlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/pw_framelayout"
                app:layout_constraintTop_toBottomOf="@+id/pw_framelayout">

                <ImageView
                    android:id="@+id/pw_error_imgview"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close_default" />

                <TextView
                    android:id="@+id/pw_error_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/suit_medium"
                    android:text="@string/loginerror"
                    android:textColor="@color/red400"
                    android:textSize="12dp"
                    android:layout_marginLeft="6dp"/>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login_constraintlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pw_constraintlayout">

            <Button
                android:id="@+id/login_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_round_primary"
                android:onClick="@{() -> fragment.onClickLogin()}"
                android:text="로그인"
                android:theme="@style/Theme.xlarge_round"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/find_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_constraintlayout">

            <Button
                android:id="@+id/find_id_btn"
                android:theme="@style/Theme.text_xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{() ->fragment.moveFrag(2)}"
                android:text="@string/findid"
                android:textColor="@color/gray600"/>

            <Button
                android:id="@+id/find_divider"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/ic_divider"/>

            <Button
                android:id="@+id/find_pw_btn"
                android:theme="@style/Theme.text_xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:onClick="@{() ->fragment.moveFrag(3)}"
                android:text="@string/findpw"
                android:textColor="@color/gray600"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sns_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            app:layout_constraintTop_toBottomOf="@+id/find_linearlayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/sns_divider_left"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/gray300"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/sns_title"
                app:layout_constraintTop_toTopOf="@+id/sns_title"
                app:layout_constraintBottom_toBottomOf="@+id/sns_title"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/sns_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다른 방법으로 로그인"
                android:textSize="12dp"
                android:textColor="@color/gray600"
                android:fontFamily="@font/suit_medium"
                android:background="@color/white"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/sns_divider_right"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/gray300"
                app:layout_constraintStart_toEndOf="@+id/sns_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sns_title"
                app:layout_constraintBottom_toBottomOf="@+id/sns_title"
                android:layout_marginStart="12dp" />

            <LinearLayout
                android:id="@+id/sns_button_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/sns_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <ImageButton
                    android:onClick="@{() -> fragment.onClickGoogleLogin()}"
                    android:id="@+id/btn_google_login"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_social_circle_google"
                    android:src="@drawable/ic_google"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:contentDescription="Google Login" />
                <ImageButton
                    android:onClick="@{() -> fragment.onClickKakaoLogin()}"
                    android:id="@+id/btn_kakao_login"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_social_circle_kakao"
                    android:src="@drawable/ic_kakao"
                    android:scaleType="fitCenter"
                    android:contentDescription="Kakao Login" />




            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/signup_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_round_line_primary"
            android:onClick="@{() ->fragment.moveFrag(1)}"
            android:text="회원가입"
            android:textColor="@color/blue500"
            android:theme="@style/Theme.btn_round_line_xlarge"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>